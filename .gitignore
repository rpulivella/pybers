# ───────────────────────────────────────────────────────────────
# pybers .gitignore
# Based on standard Python packaging conventions.
# ───────────────────────────────────────────────────────────────

# ── macOS ──────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# ── Editors ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Local config / secrets ─────────────────────────────────────
.env
.env.local
.env.*.local
# CLAUDE.md/scripts/ticket.py name .dev.vars as the sanctioned home for the GitHub
# token. Never let this line be removed — see the author's other tooling own .gitignore for why
# this comment exists: it was named as git-ignored there once and was not.
.dev.vars
.dev.vars.*
.secrets

# ── Claude Code / harness ──────────────────────────────────────
# NOTE: CLAUDE.md is COMMITTED on purpose — it is the shared agent
# constitution. Only local, machine-specific settings are ignored.
.claude/settings.local.json
.mcp.json
# The maintainer's own working rules, which a contributor never needs.
CLAUDE.local.md

# ── workarea: ephemeral scratch, never committed ───────────────
# The whole folder is ignored EXCEPT its README, which documents the
# convention in-repo. See workarea/README.md.
workarea/*
!workarea/README.md
